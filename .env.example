# --- TSA (Time Stamp Authority) ---
# No se usa TSA publica por defecto.
# Configurar con la TSA cualificada contratada antes de operar.
TSA_PRIMARY_URL=
TSA_SECONDARY_URL=
TSA_TIMEOUT_SECONDS=10
TSA_MAX_RETRIES=3

# --- Secretos obligatorios (no vacios en produccion) ---
# La aplicacion debe fallar al iniciar si estos valores estan vacios
# y APP_ENV != development.
SESSION_SECRET=
DATABASE_URL=
REDIS_URL=
