# ---------------------------------------------------------------------------
# Evidence Integrity OS - Variables de entorno (plantilla)
# ---------------------------------------------------------------------------
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al repositorio.
# ---------------------------------------------------------------------------

# --- Entorno ---
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG
APP_BASE_URL=http://localhost:8000

# --- Base de datos ---
DATABASE_URL=postgresql://evidence:evidence_dev_only@localhost:5432/evidence_dev
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Secretos obligatorios (no vacios cuando APP_ENV != development) ---
SESSION_SECRET=

# --- KMS ---
KMS_BACKEND=local
KMS_SIGN_KEY_ID=
KMS_HMAC_KEY_ID=
KMS_AWS_REGION=us-east-1
KMS_AZURE_VAULT_URL=
KMS_VAULT_ADDR=
KMS_VAULT_TOKEN=

# --- TSA ---
# No se usa TSA publica por defecto.
TSA_PRIMARY_URL=
TSA_SECONDARY_URL=
TSA_TIMEOUT_SECONDS=10
TSA_MAX_RETRIES=3
TSA_TRUST_STORE_PATH=

# --- Firma PAdES ---
PADES_CERT_PATH=
PADES_KEY_PATH=
PADES_CA_CHAIN_PATH=
PADES_TSA_URL=

# --- Mercado Pago ---
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_ENV=sandbox

# --- API ---
API_RATE_LIMIT_PER_MINUTE=60
API_PUBLIC_TOKEN_LENGTH=16

# --- Retencion ---
DEFAULT_RETENTION_POLICY=standard

# --- Auditoria ---
AUDIT_LOG_PATH=./logs/audit.jsonl
AUDIT_ANCHOR_ENABLED=false
AUDIT_ANCHOR_INTERVAL_MINUTES=60

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:8000
